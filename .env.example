# HES / Device API
DEVICE_API_URL=https://smartgrid.ifc.com.vn:6336/api/ds_thietbi_IEC_104
DEVICE_REFRESH_MS=100000

# IEC-104
IEC104_COMMON_ADDRESS=2
IEC104_ORIGINATOR_ADDRESS=1
IEC104_RECONNECT_DELAY_MS=5000
IEC104_HEARTBEAT_MS=20000
IEC104_SOCKET_IDLE_TIMEOUT_MS=60000
IEC104_RAW_LOG=true

# WebSocket HTTPS - v0.2.2 RS256 secure gateway
WS_HOST=0.0.0.0
WS_PORT=6332
WS_PATH=/ws
SSL_KEY_PATH=/opt/cer/ifcssl2026-privatekey.key
SSL_CERT_PATH=/opt/cer/fullchain.pem

# Web App ký WS ticket bằng RSA PRIVATE key.
# HES CHỈ giữ RSA PUBLIC key (>= 2048 bit) và dùng để verify.
WS_JWT_PUBLIC_KEY_PATH=./config/keys/webapp-ws-public.pem
WS_JWT_ISSUER=smartgrid-web
WS_JWT_AUDIENCE=hes104-ws
# Khuyến nghị đặt kid cố định để tránh nhận nhầm key trong quá trình rotate.
WS_JWT_KEY_ID=smartgrid-ws-2026-01
WS_TICKET_MAX_AGE_SEC=120
WS_JWT_CLOCK_TOLERANCE_SEC=5
WS_TICKET_SINGLE_USE=true

# Mặc định ticket không nằm trên URL. Browser gửi qua Sec-WebSocket-Protocol:
# new WebSocket(url, ['hes104-v1', `ticket.${ticket}`])
WS_TICKET_TRANSPORT=protocol
# Chỉ bật tạm thời khi migrate client v0.2.1 cũ. Không khuyến nghị production.
WS_ALLOW_LEGACY_QUERY_TICKET=false

# Ticket 120s chỉ dùng cho handshake. Session có lifetime độc lập.
# Sau thời gian này HES close code 1000 để client lấy ticket mới và reconnect.
WS_SESSION_MAX_AGE_SEC=3600

# Browser Origin allowlist. Phân tách nhiều origin bằng dấu phẩy.
WS_REQUIRE_ORIGIN=true
WS_ALLOWED_ORIGINS=https://smartgrid.ifc.com.vn

# WebSocket abuse protection
WS_MAX_PAYLOAD_BYTES=65536
WS_HEARTBEAT_MS=30000
WS_MAX_MESSAGES_PER_MINUTE=120
WS_MAX_SUBSCRIPTIONS=1000
WS_MAX_CLIENTS=200
WS_MAX_CONNECTIONS_PER_IP=5
# Chỉ khai báo IP reverse proxy mà anh kiểm soát; để trống nếu client nối trực tiếp.
WS_TRUST_PROXY_IPS=

# Control: mặc định TẮT. Chỉ bật sau khi tạo whitelist control-points.json.
CONTROL_ENABLED=false
CONTROL_POINTS_PATH=./config/control-points.json

# Redis / Bull
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=
QUEUE_ATTEMPTS=3
QUEUE_RETRY_DELAY_MS=5000
QUEUE_KEEP_COMPLETED=1000
QUEUE_KEEP_FAILED=5000

# PostgreSQL
DB_USER=
DB_PASS=
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_POOL_MAX=20
DB_CONNECT_TIMEOUT=15000
DB_POOL_TIMEOUT=60000
DB_CALL_TIMEOUT=60000
DB_CHUNK_SIZE=1000

# Worker: default 1 để giữ thứ tự update realtime an toàn.
WORKER_CONCURRENCY=1
WORKER_JOB_TIMEOUT_MS=60000

# Oracle legacy (chỉ dùng Import/db_bk.js nếu cần rollback)
# ORACLE_DB_USER=
# ORACLE_DB_PASS=
# ORACLE_DB_CONNECT=
